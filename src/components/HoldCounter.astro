// Press-and-hold timer. All state is client-side and in-memory only.
---
<div class="stage">
  <div class="eyebrow">Do you REALLY miss someone ??</div>
  <h1>How long.. can you miss ?</h1>
  <p class="subtitle">Most important thing you can give to someone is<br>YOUR TIME</p>

  <div class="panel details-panel">
    <div class="details-header">
      <span class="details-eyebrow">Whom you miss</span>
      <span class="details-optional">Freezes on start (no data is saved)</span>
    </div>
    <div class="details-fields">
      <label class="field">
        <span class="field-label">The Lucky Person</span>
        <input type="text" id="userName" class="field-input" placeholder="Name" autocomplete="name" />
      </label>
      <label class="field">
        <span class="field-label">Their ID (Insta/WA/Email)</span>
        <input type="email" id="userEmail" class="field-input" placeholder="Any unique ID" autocomplete="email" />
      </label>
    </div>
  </div>
  <p class="subtitle2">howLongCanU.com</p>
  <div class="panel">
    <div class="readouts">
      <div class="readout">
        <div class="readout-label"><span class="dot" id="dot-last"></span>Last hold</div>
        <div class="readout-value" id="val-last">0.00<span class="readout-unit">s</span></div>
      </div>
      <div class="readout">
        <div class="readout-label"><span class="dot" id="dot-count"></span>Presses</div>
        <div class="readout-value" id="val-count">000</div>
      </div>
      <div class="readout wide">
        <div class="readout-label"><span class="dot" id="dot-total"></span>Total time your heart missed ♥</div>
        <div class="readout-value" id="val-total">0.00<span class="readout-unit">s</span></div>
      </div>
    </div>
  </div>
  
  <div class="btn-zone">
    <div class="bounce-track" aria-hidden="true">
            <div class="bounce-ball"></div>
    </div>
    <div class="horizon" id="horizon" aria-hidden="true">
      <div class="horizon-fill" id="horizonFill"></div>
    </div>
    <span class="horizon-caption" id="horizonCaption">Ray of Hope</span>

    <button class="push" id="pushBtn" aria-label="Press and hold">
      <span class="ring"></span>
    </button>
    <div class="push-label" id="pushLabel">Press and hold</div>
  </div>
  <div class="ist-clock" id="istClock">--</div>
  <div class="footnote">
    Start over:<button id="resetBtn" type="button">reset session</button>, or refresh the page.
  </div>

  <div class="snapshot-zone">
    <button class="snapshot-btn" id="snapshotBtn" type="button">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M4 8.5C4 7.39543 4.89543 6.5 6 6.5H8.17157C8.70201 6.5 9.21071 6.28929 9.58579 5.91421L10.4142 5.08579C10.7893 4.71071 11.298 4.5 11.8284 4.5H12.1716C12.702 4.5 13.2107 4.71071 13.5858 5.08579L14.4142 5.91421C14.7893 6.28929 15.298 6.5 15.8284 6.5H18C19.1046 6.5 20 7.39543 20 8.5V17.5C20 18.6046 19.1046 19.5 18 19.5H6C4.89543 19.5 4 18.6046 4 17.5V8.5Z" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="12" cy="13" r="3.5" stroke="currentColor" stroke-width="1.5"/>
      </svg>
      <span id="snapshotBtnLabel">Capture the Efforts</span>
    </button>
    <div class="snapshot-hint">Share with one, who matters ♥ </div>
  </div>

  <!-- NEW: collapsible donation section (Option A — native <details>, no JS needed) -->
  <div class="donation-zone">
    <details class="donation-section">
      <summary>
        <span class="donation-summary-text">♥ Support this page</span>
        <span class="donation-chevron" aria-hidden="true"></span>
      </summary>
      <div class="donation-content">
          <a
          href="upi://pay?pa=soniamehta0301@okaxis&pn=Donation&cu=INR"
          class="donation-image-link"
          aria-label="Pay via UPI"
            >
        <img src="/images/donation.jpeg" alt="Donation QR code" class="donation-image" loading="lazy" />
          </a>
        <p class="donation-caption">To keep this site running for every Heart!!</p>
      </div>
    </details>
  </div>
</div>

<!-- NEW: crop-selection overlay, shown after "Capture the Efforts" is clicked -->
<div class="crop-modal" id="cropModal" hidden>
  <div class="crop-modal-inner">
    <div class="crop-stage" id="cropStage">
      <img id="cropImage" alt="Snapshot preview" draggable="false" />
      <div class="crop-box" id="cropBox">
        <div class="crop-handle" data-handle="nw"></div>
        <div class="crop-handle" data-handle="ne"></div>
        <div class="crop-handle" data-handle="sw"></div>
        <div class="crop-handle" data-handle="se"></div>
      </div>
    </div>
    <div class="crop-actions">
      <button id="cropCancelBtn" type="button">Cancel</button>
      <button id="cropConfirmBtn" type="button">Use this area</button>
    </div>
    <div class="crop-hint">Drag to select an area · drag a corner to resize · drag the box to move it</div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;1,9..144,500&display=swap');

  .stage {
    width: 100%;
    max-width: 480px;
    padding: 40px 20px 56px;
  }

  .eyebrow {
    text-align: center;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 8px;
  }

  h1 {
    text-align: center;
    font-weight: 700;
    font-size: clamp(26px, 6vw, 34px);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .subtitle {
    text-align: center;
    font-size: 14px;
    color: var(--muted);
    margin: 8px 0 28px;
    font-weight: 400;
  }
  .subtitle2 {
    text-align: center;
    font-size: 10px;
    color: var(--muted);
    margin: 1px 0 8px;
    font-weight: 400;
  }

  .panel {
    background: linear-gradient(180deg, var(--panel-raised), var(--panel));
    border: 1px solid var(--panel-border);
    border-radius: var(--radius-lg);
    padding: 15px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.03) inset,
      0 30px 60px -30px rgba(0, 0, 0, 0.6);
  }

  .details-panel {
    margin-bottom: 10px;
  }

  .details-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .details-eyebrow {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 10px;
    color: var(--muted);
  }

  .details-optional {
    font-size: 9px;
    color: var(--muted-dim);
    font-style: italic;
  }

  .details-fields {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 12px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .field-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-dim);
  }

  .field-input {
    width: 100%;
    box-sizing: border-box;
    background: var(--well);
    border: 1px solid var(--well-border);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
    color: var(--ink);
    font-family: 'Fraunces', Georgia, serif;
    font-style: italic;
    font-weight: 500;
    font-size: 17px;
    letter-spacing: 0.01em;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    min-width: 0;
  }

  .field-input::placeholder {
    color: var(--muted-dim);
    font-style: italic;
    opacity: 0.75;
  }

  .field-input:focus {
    border-color: var(--accent-dim);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .field-input:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    background: var(--well);
  }

  @media (max-width: 380px) {
    .details-fields {
      grid-template-columns: 1fr;
    }
  }

  .readouts {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 12px;
  }

  .readout {
    background: var(--well);
    border: 1px solid var(--well-border);
    border-radius: var(--radius-md);
    padding: 12px 12px 10px;
  }

  .readout.wide { grid-column: 1 / -1; }

  .readout-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted-dim);
    box-shadow: none;
    transition: background 0.2s ease, box-shadow 0.2s ease;
    flex-shrink: 0;
  }

  .dot.live {
    background: var(--accent);
    box-shadow: 0 0 8px 2px var(--accent-glow);
  }

  .readout-value {
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 600;
    font-size: clamp(24px, 7vw, 30px);
    color: var(--accent);
    letter-spacing: 0.01em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .readout.wide .readout-value {
    font-size: clamp(28px, 8vw, 34px);
  }

  .readout-unit {
    font-size: 13px;
    color: var(--muted);
    margin-left: 4px;
  }

  .btn-zone {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 8px;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    user-select: none;
  }

  /* Small & sweet bouncing ball, hopping along the full width of the
     horizon line just above it. */
  .bounce-track {
    position: relative;
    width: 100%;
    max-width: 260px;
    height: 30px;
    margin-bottom: 6px;
  }
  
  .bounce-ball {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px 1px var(--accent-glow);
    animation:
      bounce-hop 0.45s cubic-bezier(0.5, 0, 1, 0.5) infinite alternate,
      bounce-travel 3.6s linear infinite alternate;
  }
  
  @keyframes bounce {
    from { bottom: 0; }
    to { bottom: 27px; }
  }
  @keyframes bounce-travel {
    from { left: 0%; }
    to { left: calc(100% - 8px); }
  }
  
  @media (prefers-reduced-motion: reduce) {
    .bounce-ball { animation: none; }
  }

  /* Signature element: a thin horizon line that warms from dusk teal
     toward dawn gold as a hold lengthens — patience made visible. */
  .horizon {
    width: 100%;
    max-width: 260px;
    height: 3px;
    border-radius: 2px;
    background: var(--well);
    border: 1px solid var(--well-border);
    overflow: hidden;
    margin-bottom: 10px;
  }

  .horizon-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--dusk), var(--dusk));
    transition: width 0.05s linear;
  }

  .horizon-caption {
    font-size: 11px;
    color: var(--muted-dim);
    letter-spacing: 0.02em;
    margin-bottom: 22px;
  }

    .push {
      width: 148px;
      height: 148px;
      border-radius: 50%;
      border: none;
      cursor: pointer;
      position: relative;
      background: radial-gradient(circle at 35% 30%, #4a8b83, #2c5751 55%, #1c3b37 100%);
      box-shadow:
        0 8px 0 #14302c,
        0 14px 28px rgba(0, 0, 0, 0.45),
        inset 0 3px 6px rgba(255, 255, 255, 0.12),
        inset 0 -8px 14px rgba(0, 0, 0, 0.3);
      transform: translateY(0);
      transition: transform 0.06s ease, box-shadow 0.06s ease;
      touch-action: none;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
      -webkit-tap-highlight-color: transparent;
      animation: breathe 5s ease-in-out infinite;
  }

  @keyframes breathe {
    0%, 100% { filter: brightness(1); }
    50% { filter: brightness(1.08); }
  }

  .push:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 6px;
  }

  .push .ring {
  position: absolute;
  inset: -10px;
  border-radius: 50%;
  border: 2px solid var(--accent-dim);
  opacity: 0;
  transition: opacity 0.15s ease, transform 0.15s ease;
  pointer-events: none;
  will-change: opacity, transform;
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  transform: translateZ(0);
  }

  .push.active {
    animation: none;
    transform: translateY(6px) translateZ(0);
    box-shadow:
      0 2px 0 #14302c,
      0 4px 10px rgba(0, 0, 0, 0.4),
      inset 0 4px 10px rgba(0, 0, 0, 0.35),
      inset 0 -4px 8px rgba(255, 255, 255, 0.06);
  }

  .push.active .ring {
  opacity: 1;
  transform: scale(1.1) translateZ(0);
  border-color: var(--accent);
  box-shadow: 0 0 16px 2px var(--accent-glow);
  }

  .push-label {
    margin-top: 22px;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: center;
    transition: color 0.15s ease;
  }

  .push-label.active { color: var(--accent); }

  .ist-clock {
  margin-top: 10px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 12px;
  letter-spacing: 0.02em;
  color: var(--muted-dim);
  text-align: center;
  }

  .footnote {
    text-align: center;
    margin-top: 24px;
    font-size: 12px;
    color: var(--muted-dim);
    letter-spacing: 0.01em;
    line-height: 1.6;
  }

  .footnote button {
    background: none;
    border: none;
    color: var(--muted);
    font-family: inherit;
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
    padding: 0;
  }

  .footnote button:hover { color: var(--accent); }

  .snapshot-zone {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 18px;
  }

  .snapshot-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--panel-raised);
    border: 1px solid var(--panel-border);
    color: var(--ink);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.04em;
    padding: 10px 18px;
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, transform 0.1s ease;
  }

  .snapshot-btn svg { color: var(--accent); flex-shrink: 0; }

  .snapshot-btn:hover {
    border-color: var(--accent-dim);
    color: var(--accent);
  }

  .snapshot-btn:active { transform: translateY(1px); }

  .snapshot-btn:disabled {
    opacity: 0.6;
    cursor: default;
    transform: none;
  }

  .snapshot-hint {
    margin-top: 8px;
    font-size: 11px;
    color: var(--muted-dim);
    text-align: center;
  }

  /* NEW: collapsible donation section */
  .donation-zone {
    display: flex;
    justify-content: center;
    margin-top: 26px;
  }

  .donation-section {
    width: 100%;
    max-width: 280px;
  }

  .donation-section summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    list-style: none;
    cursor: pointer;
    background: var(--panel-raised);
    border: 1px solid var(--panel-border);
    color: var(--muted);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.04em;
    padding: 10px 18px;
    border-radius: 999px;
    transition: border-color 0.15s ease, color 0.15s ease;
    -webkit-user-select: none;
    user-select: none;
  }

  .donation-section summary::-webkit-details-marker {
    display: none;
  }

  .donation-section summary:hover {
    border-color: var(--accent-dim);
    color: var(--accent);
  }

  .donation-chevron {
    width: 8px;
    height: 8px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .donation-section[open] summary {
    color: var(--accent);
    border-color: var(--accent-dim);
  }

  .donation-section[open] .donation-chevron {
    transform: rotate(-135deg);
  }

  .donation-content {
    margin-top: 12px;
    padding: 14px;
    background: var(--well);
    border: 1px solid var(--well-border);
    border-radius: var(--radius-md);
    text-align: center;
    animation: donation-reveal 0.2s ease;
  }

  @keyframes donation-reveal {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .donation-image {
    max-width: 100%;
    border-radius: 8px;
    display: block;
    margin: 0 auto;
  }

  .donation-image-link:active {
    transform: scale(0.98);
    opacity: 0.9;
  }

  .donation-caption {
    margin: 10px 0 0;
    font-size: 11px;
    color: var(--muted-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    .donation-content { animation: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .push { animation: none; }
    .push, .push .ring, .horizon-fill { transition: none; }
  }

  @media (hover: none) and (pointer: coarse) {
    .push {
      animation: none;
    }
  }

  /* NEW: crop-selection overlay */
  .crop-modal {
    position: fixed;
    inset: 0;
    background: rgba(6, 12, 13, 0.88);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
  }

  .crop-modal[hidden] { display: none; }

  .crop-modal-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 100%;
  }

  .crop-stage {
    position: relative;
    display: inline-block;
    line-height: 0;
    max-width: 90vw;
    max-height: 62vh;
    touch-action: none;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.55);
  }

  .crop-stage img {
    display: block;
    max-width: 90vw;
    max-height: 62vh;
    width: auto;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .crop-box {
    position: absolute;
    border: 2px solid var(--accent);
    box-shadow: 0 0 0 9999px rgba(6, 12, 13, 0.62);
    cursor: move;
    touch-action: none;
  }

  .crop-handle {
    position: absolute;
    width: 16px;
    height: 16px;
    background: var(--accent);
    border: 2px solid #0a1416;
    border-radius: 50%;
    touch-action: none;
  }

  .crop-handle[data-handle="nw"] { left: -9px; top: -9px; cursor: nwse-resize; }
  .crop-handle[data-handle="ne"] { right: -9px; top: -9px; cursor: nesw-resize; }
  .crop-handle[data-handle="sw"] { left: -9px; bottom: -9px; cursor: nesw-resize; }
  .crop-handle[data-handle="se"] { right: -9px; bottom: -9px; cursor: nwse-resize; }

  .crop-actions {
    display: flex;
    gap: 10px;
  }

  .crop-actions button {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 10px 20px;
    border-radius: 999px;
    cursor: pointer;
    border: 1px solid var(--panel-border);
    background: var(--panel-raised);
    color: var(--ink);
    transition: border-color 0.15s ease, transform 0.1s ease;
  }

  .crop-actions button:active { transform: translateY(1px); }

  #cropConfirmBtn {
    background: var(--accent);
    color: #0a1416;
    border-color: var(--accent);
  }

  .crop-hint {
    font-size: 11px;
    color: var(--muted-dim);
    text-align: center;
    max-width: 320px;
  }
</style>

<script>
  (function () {
    const btn = document.getElementById('pushBtn');
    const pushLabel = document.getElementById('pushLabel');
    const valLast = document.getElementById('val-last');
    const valCount = document.getElementById('val-count');
    const valTotal = document.getElementById('val-total');
    const dotLast = document.getElementById('dot-last');
    const dotCount = document.getElementById('dot-count');
    const dotTotal = document.getElementById('dot-total');
    const resetBtn = document.getElementById('resetBtn');
    const horizonFill = document.getElementById('horizonFill');
    const horizonCaption = document.getElementById('horizonCaption');

    const userNameInput = document.getElementById('userName');
    const userEmailInput = document.getElementById('userEmail');

    // Colors for the dusk -> dawn interpolation (kept in sync with CSS tokens).
    const DUSK = [58, 111, 120];   // --dusk
    const DAWN = [234, 182, 118];  // --dawn
    const HORIZON_CAP_MS = 60000;  // full warmth reached at 60s held
    
    // Datetime code piece -line number 471 to 500
    const istClockEl = document.getElementById('istClock');

    function formatISTClock(date) {
      const weekday = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Kolkata',
        weekday: 'long',
      }).format(date);
    
      const parts = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Kolkata',
        day: '2-digit',
        month: 'short',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      }).formatToParts(date);
    
      const map = {};
      parts.forEach((p) => { map[p.type] = p.value; });
    
      return `${weekday}, ${map.day} ${map.month}, ${map.hour}:${map.minute}:${map.second}`;
    }
    
    function tickClock() {
      istClockEl.textContent = formatISTClock(new Date());
    }
    
    tickClock();
    setInterval(tickClock, 1000);

    let pressCount = 0;
    let cumulativeMs = 0;
    let pressStart = null;
    let rafId = null;
    let activePointerId = null;

    function formatSeconds(ms) {
      const s = ms / 1000;
      if (s < 60) return s.toFixed(2) + 's';
      const mins = Math.floor(s / 60);
      const secs = (s - mins * 60).toFixed(2).padStart(5, '0');
      return mins + ':' + secs;
    }

    function lerpColor(a, b, t) {
      const c = a.map((v, i) => Math.round(v + (b[i] - v) * t));
      return `rgb(${c[0]}, ${c[1]}, ${c[2]})`;
    }

    function updateHorizon(heldMs) {
      const t = Math.max(0, Math.min(1, heldMs / HORIZON_CAP_MS));
      horizonFill.style.width = (t * 100).toFixed(1) + '%';
      horizonFill.style.background = lerpColor(DUSK, DAWN, t);
      if (heldMs === 0) {
        horizonCaption.textContent = 'Ray of Hope';
      } else if (t < 1) {
        horizonCaption.textContent = 'Warming…';
      } else {
        horizonCaption.textContent = 'Completed a minute !!';
      }
    }

    function renderStatic() {
      valCount.textContent = String(pressCount).padStart(3, '0');
      valTotal.innerHTML = formatSeconds(cumulativeMs);
    }

    function renderLastFinal(durationMs) {
      valLast.innerHTML = formatSeconds(durationMs);
    }

    function tick() {
      if (pressStart === null) return;
      const now = performance.now();
      const held = now - pressStart;
      valLast.innerHTML = formatSeconds(held);
      valTotal.innerHTML = formatSeconds(cumulativeMs + held);
      updateHorizon(held);
      rafId = requestAnimationFrame(tick);
    }

    function startPress(e) {
      if (pressStart !== null) return;
      if (e.cancelable) e.preventDefault();
      activePointerId = e.pointerId;
      if (btn.setPointerCapture && e.pointerId !== undefined) {
        try { btn.setPointerCapture(e.pointerId); } catch (err) {}
      }
      pressStart = performance.now();

      userNameInput.disabled = true;
      userEmailInput.disabled = true;

      btn.classList.add('active');
      pushLabel.textContent = 'Holding…';
      pushLabel.classList.add('active');
      dotLast.classList.add('live');
      dotTotal.classList.add('live');
      rafId = requestAnimationFrame(tick);
    }

    function endPress(e) {
      if (pressStart === null) return;
      if (e && e.pointerId !== undefined && activePointerId !== null && e.pointerId !== activePointerId) return;
      const durationMs = performance.now() - pressStart;
      cumulativeMs += durationMs;
      pressCount += 1;
      pressStart = null;
      activePointerId = null;

      if (rafId) cancelAnimationFrame(rafId);
      rafId = null;

      btn.classList.remove('active');
      pushLabel.textContent = 'Press and hold';
      pushLabel.classList.remove('active');
      dotLast.classList.remove('live');
      dotTotal.classList.remove('live');
      dotCount.classList.add('live');
      setTimeout(() => dotCount.classList.remove('live'), 220);

      renderLastFinal(durationMs);
      renderStatic();

      // Horizon eases back to rest rather than snapping.
      horizonFill.style.transition = 'width 0.6s ease, background 0.6s ease';
      updateHorizon(0);
      setTimeout(() => { horizonFill.style.transition = 'width 0.05s linear'; }, 650);
    }

    btn.addEventListener('pointerdown', startPress);
    btn.addEventListener('pointerup', endPress);
    btn.addEventListener('pointercancel', endPress);
    btn.addEventListener('lostpointercapture', endPress);

    // Keyboard support: space/enter act as press-and-hold
    let keyHeld = false;
    btn.addEventListener('keydown', function (e) {
      if ((e.code === 'Space' || e.code === 'Enter') && !keyHeld) {
        keyHeld = true;
        startPress({ preventDefault: () => {}, cancelable: false, pointerId: undefined });
      }
    });
    btn.addEventListener('keyup', function (e) {
      if (e.code === 'Space' || e.code === 'Enter') {
        keyHeld = false;
        endPress({ pointerId: undefined });
      }
    });

    resetBtn.addEventListener('click', function () {
      pressCount = 0;
      cumulativeMs = 0;
      pressStart = null;
      renderStatic();
      valLast.innerHTML = '0.00<span class="readout-unit">s</span>';
      updateHorizon(0);
      // Name/Email stay frozen after a reset too — "reset session" clears
      // the counters, not who the session is dedicated to.
    });

    renderStatic();
    updateHorizon(0);

    // ---- Snapshot: capture the card as an image, stamped with IST time ----
    const snapshotBtn = document.getElementById('snapshotBtn');
    const snapshotBtnLabel = document.getElementById('snapshotBtnLabel');
    const stageEl = document.querySelector('.stage');

    function loadHtml2Canvas() {
      if (window.html2canvas) return Promise.resolve(window.html2canvas);
      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
        script.onload = () => resolve(window.html2canvas);
        script.onerror = () => reject(new Error('Could not load snapshot library.'));
        document.head.appendChild(script);
      });
    }

    // Builds "YYYY-MM-DD HH:MM" in Asia/Kolkata regardless of the visitor's own timezone.
    function formatISTTimestamp(date) {
      const parts = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'Asia/Kolkata',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      }).formatToParts(date);
      const map = {};
      parts.forEach((p) => { map[p.type] = p.value; });
      return `${map.year}-${map.month}-${map.day} ${map.hour}:${map.minute}`;
    }

    function stampTimestamp(canvas, scale) {
      const ctx = canvas.getContext('2d');
      const timestamp = formatISTTimestamp(new Date());
      const holder = (userNameInput.value || '').trim();
      const label = (holder ? 'Held by ' + holder + ' · ' : 'Captured ') + timestamp + ' IST';

      // A full-width watermark band using the site's own dusk → dawn
      // gradient, so the stamp reads as part of the design, not a sticker.
      const barH = Math.max(30 * scale, Math.round(canvas.height * 0.05));

      const grad = ctx.createLinearGradient(0, 0, canvas.width, 0);
      grad.addColorStop(0, '#3a6f78');   // --dusk
      grad.addColorStop(1, '#eab676');   // --dawn
      ctx.fillStyle = grad;
      ctx.fillRect(0, canvas.height - barH, canvas.width, barH);

      // hairline seam so the band reads as an edge, not an overlay
      ctx.fillStyle = 'rgba(255, 255, 255, 0.45)';
      ctx.fillRect(0, canvas.height - barH, canvas.width, Math.max(1, scale));

      const fontSize = Math.max(11 * scale, barH * 0.4);
      ctx.font = `600 ${fontSize}px 'Space Grotesk', sans-serif`;
      ctx.textBaseline = 'middle';
      ctx.textAlign = 'center';
      ctx.fillStyle = '#0a1416';
      ctx.fillText(label, canvas.width / 2, canvas.height - barH / 2 + fontSize * 0.03);
      ctx.textAlign = 'left';
      return canvas;
    }

    // Converts a canvas to a Blob via a Promise (canvas.toBlob is callback-based).
    function canvasToBlob(canvas) {
      return new Promise((resolve, reject) => {
        canvas.toBlob((blob) => {
          if (blob) resolve(blob);
          else reject(new Error('Canvas could not be converted to an image.'));
        }, 'image/png');
      });
    }
 
    // Only mobile browsers get the share-sheet flow. Some desktop browsers
    // (Edge, macOS Safari) also expose navigator.share, but on desktop the
    // classic <a download> already works and downloads instantly — no need
    // to interrupt that with a share sheet.
    function isMobileDevice() {
      return /Android|iPhone|iPad|iPod|Mobi/i.test(navigator.userAgent);
    }
 
    async function saveOrShareImage(blob, filename) {
      const file = new File([blob], filename, { type: 'image/png' });
      const mobile = isMobileDevice();
 
      if (mobile && navigator.canShare && navigator.canShare({ files: [file] })) {
        try {
          await navigator.share({
            files: [file],
            title: 'Hold Counter',
          });
          return 'shared';
        } catch (err) {
          // User cancelled the share sheet — not an error, just stop here.
          if (err && err.name === 'AbortError') return 'cancelled';
          // Otherwise fall through to the other strategies below.
        }
      }
 
      const isIOS = /iP(hone|ad|od)/.test(navigator.userAgent);
      const url = URL.createObjectURL(blob);
 
      if (mobile && isIOS) {
        // download attribute is unsupported on iOS Safari; opening the
        // image in a new tab lets the user long-press it and choose
        // "Save Image" or "Add to Photos" themselves.
        window.open(url, '_blank');
        setTimeout(() => URL.revokeObjectURL(url), 60000);
        return 'opened';
      }
 
      // Desktop (and most Android browsers as a fallback): normal
      // anchor-download flow — downloads immediately, same as before.
      const link = document.createElement('a');
      link.href = url;
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 60000);
      return 'downloaded';
    }

    // ---- NEW: crop-selection overlay logic ----
    const cropModal = document.getElementById('cropModal');
    const cropStage = document.getElementById('cropStage');
    const cropImage = document.getElementById('cropImage');
    const cropBox = document.getElementById('cropBox');
    const cropCancelBtn = document.getElementById('cropCancelBtn');
    const cropConfirmBtn = document.getElementById('cropConfirmBtn');

    let cropRect = null; // { x, y, w, h } in CSS pixels relative to cropStage

    function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }

    function setCropBox(x, y, w, h) {
      const stageW = cropStage.clientWidth;
      const stageH = cropStage.clientHeight;
      w = clamp(w, 24, stageW);
      h = clamp(h, 24, stageH);
      x = clamp(x, 0, stageW - w);
      y = clamp(y, 0, stageH - h);
      cropRect = { x, y, w, h };
      cropBox.style.left = x + 'px';
      cropBox.style.top = y + 'px';
      cropBox.style.width = w + 'px';
      cropBox.style.height = h + 'px';
    }

    // Opens the crop overlay for a freshly captured (un-stamped) canvas.
    // Resolves with { rect, stageWidth } on confirm, or null on cancel.
    function openCropModal(canvas, defaultHeightRatio) {
      return new Promise((resolve) => {
        cropImage.src = canvas.toDataURL('image/png');

        function finish(result) {
          cropModal.hidden = true;
          cropConfirmBtn.removeEventListener('click', onConfirm);
          cropCancelBtn.removeEventListener('click', onCancel);
          cropImage.onload = null;
          resolve(result);
        }
        function onConfirm() {
          finish({ rect: cropRect, stageWidth: cropStage.clientWidth });
        }
        function onCancel() {
          finish(null);
        }

        cropConfirmBtn.addEventListener('click', onConfirm);
        cropCancelBtn.addEventListener('click', onCancel);

        cropImage.onload = function () {
          cropModal.hidden = false;
          // Default selection: full width, from the top of the card down
          // through the IST datetime line — the user can still drag to
          // include more (e.g. the donation section) or less.
          requestAnimationFrame(() => {
            const stageW = cropStage.clientWidth;
            const stageH = cropStage.clientHeight;
            const ratio = defaultHeightRatio || 1;
            setCropBox(0, 0, stageW, stageH * ratio);
          });
        };
      });
    }

    // Drag state machine: draw a new box, move it, or resize from a corner.
    let dragMode = null; // 'create' | 'move' | 'resize'
    let dragHandle = null;
    let dragOriginX = 0;
    let dragOriginY = 0;
    let boxAtDragStart = null;

    function stagePoint(e) {
      const rect = cropStage.getBoundingClientRect();
      return { x: e.clientX - rect.left, y: e.clientY - rect.top };
    }

    cropStage.addEventListener('pointerdown', (e) => {
      if (e.target.classList.contains('crop-handle')) return;
      const p = stagePoint(e);
      if (e.target === cropBox) {
        dragMode = 'move';
        boxAtDragStart = { ...cropRect, px: p.x, py: p.y };
      } else {
        dragMode = 'create';
        dragOriginX = p.x;
        dragOriginY = p.y;
        setCropBox(p.x, p.y, 1, 1);
      }
      try { cropStage.setPointerCapture(e.pointerId); } catch (err) {}
    });

    cropBox.querySelectorAll('.crop-handle').forEach((handleEl) => {
      handleEl.addEventListener('pointerdown', (e) => {
        e.stopPropagation();
        dragMode = 'resize';
        dragHandle = handleEl.dataset.handle;
        boxAtDragStart = { ...cropRect };
        dragOriginX = e.clientX;
        dragOriginY = e.clientY;
        try { cropStage.setPointerCapture(e.pointerId); } catch (err) {}
      });
    });

    cropStage.addEventListener('pointermove', (e) => {
      if (!dragMode) return;
      if (dragMode === 'create') {
        const p = stagePoint(e);
        const x = Math.min(dragOriginX, p.x);
        const y = Math.min(dragOriginY, p.y);
        const w = Math.abs(p.x - dragOriginX);
        const h = Math.abs(p.y - dragOriginY);
        setCropBox(x, y, w, h);
      } else if (dragMode === 'move') {
        const p = stagePoint(e);
        const dx = p.x - boxAtDragStart.px;
        const dy = p.y - boxAtDragStart.py;
        setCropBox(boxAtDragStart.x + dx, boxAtDragStart.y + dy, boxAtDragStart.w, boxAtDragStart.h);
      } else if (dragMode === 'resize') {
        const dx = e.clientX - dragOriginX;
        const dy = e.clientY - dragOriginY;
        let { x, y, w, h } = boxAtDragStart;
        if (dragHandle.includes('e')) w = boxAtDragStart.w + dx;
        if (dragHandle.includes('s')) h = boxAtDragStart.h + dy;
        if (dragHandle.includes('w')) { x = boxAtDragStart.x + dx; w = boxAtDragStart.w - dx; }
        if (dragHandle.includes('n')) { y = boxAtDragStart.y + dy; h = boxAtDragStart.h - dy; }
        setCropBox(x, y, w, h);
      }
    });

    function endDrag() {
      dragMode = null;
      dragHandle = null;
      boxAtDragStart = null;
    }
    cropStage.addEventListener('pointerup', endDrag);
    cropStage.addEventListener('pointercancel', endDrag);

    // ---- Capture flow: full-page snapshot -> crop overlay -> stamp -> save/share ----
    async function takeSnapshot() {
      snapshotBtn.disabled = true;
      const originalLabel = snapshotBtnLabel.textContent;
      snapshotBtnLabel.textContent = 'Check PopUp';
      try {
        const html2canvas = await loadHtml2Canvas();
        const scale = Math.min(2, window.devicePixelRatio || 1) * 1.5;
        const bg = getComputedStyle(document.body).getPropertyValue('background-color') || '#0e1b1d';

        // Measure, before capture, how far down the card the IST timestamp
        // ends — this becomes the default crop height (top of card through
        // the datetime line), expressed as a fraction of the card's height.
        const stageRectPre = stageEl.getBoundingClientRect();
        const clockRectPre = istClockEl.getBoundingClientRect();
        const defaultCropHeightRatio = clamp(
          (clockRectPre.bottom - stageRectPre.top+10) / stageRectPre.height,
          0.05,
          1
        );

        // 1. Capture the whole card, un-stamped, at full resolution.
        const fullCanvas = await html2canvas(stageEl, {
          backgroundColor: bg.trim() || '#0e1b1d',
          scale,
          useCORS: true,
        });

        snapshotBtn.disabled = false;
        snapshotBtnLabel.textContent = originalLabel;

        // 2. Let the user pick the area they want. Cancelling here aborts
        //    the whole capture, so nothing gets saved/shared.
        const selection = await openCropModal(fullCanvas, defaultCropHeightRatio);
        if (!selection) return;

        snapshotBtn.disabled = true;
        snapshotBtnLabel.textContent = 'Capturing…';

        // 3. Map the on-screen selection (CSS px) to the full-resolution canvas.
        const factor = fullCanvas.width / selection.stageWidth;
        const sx = selection.rect.x * factor;
        const sy = selection.rect.y * factor;
        const sw = selection.rect.w * factor;
        const sh = selection.rect.h * factor;

        const croppedCanvas = document.createElement('canvas');
        croppedCanvas.width = Math.max(1, Math.round(sw));
        croppedCanvas.height = Math.max(1, Math.round(sh));
        croppedCanvas.getContext('2d').drawImage(
          fullCanvas, sx, sy, sw, sh, 0, 0, croppedCanvas.width, croppedCanvas.height
        );

        // 4. Stamp the timestamp band onto the final, cropped image.
        stampTimestamp(croppedCanvas, scale);

        const fileStamp = formatISTTimestamp(new Date()).replace(/[: ]/g, '-');
        const filename = `hold-counter-${fileStamp}-IST.png`;
        const blob = await canvasToBlob(croppedCanvas);
        const result = await saveOrShareImage(blob, filename);

        if (result === 'opened') {
          snapshotBtnLabel.textContent = 'Long-press image to save';
          setTimeout(() => { snapshotBtnLabel.textContent = originalLabel; }, 2500);
          snapshotBtn.disabled = false;
          return;
        }
      } catch (err) {
        console.error(err);
        alert('Could not capture a snapshot. Please try again.');
      } finally {
        snapshotBtn.disabled = false;
        snapshotBtnLabel.textContent = originalLabel;
      }
    }

    snapshotBtn.addEventListener('click', takeSnapshot);
  })();
</script>
